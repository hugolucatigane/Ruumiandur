# AI teenusepakkuja: auto, ollama, openai või rules.
# auto proovib esmalt Ollamat ja seejärel OpenAI-d, kui OPENAI_API_KEY on määratud.
AI_PROVIDER=auto

# Siin saab valida ükskõik millise Ollamasse paigaldatud mudeli.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI kasutamine on valikuline. Hoia päris võtit ainult .env-failis, mitte kunagi selles näidisfailis.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Simuleeritud suhtelise MQ-2 signaali prototüübi kindlad lävendid.
GAS_WARNING_PCT=70
GAS_SPIKE_PCT=20

# Perioodi kokkuvõte on lõplik ainult siis, kui olemas on vähemalt selline osa oodatud andmetest.
SUMMARY_MIN_COVERAGE_RATIO=0.8

# Märgi mõõtekanal, mille väärtus püsib piisava andmekattega perioodil sisuliselt muutumatu.
SENSOR_STUCK_WINDOW_MINUTES=120
SENSOR_STUCK_MIN_COVERAGE_RATIO=0.8
TEMP_STUCK_TOLERANCE_C=0.05
HUMIDITY_STUCK_TOLERANCE_PCT=0.05
GAS_STUCK_TOLERANCE_PCT=0.05
